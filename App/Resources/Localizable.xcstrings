    "You": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du"
          }
        }
      }
    },
    "You are part of %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gehörst zu %@."
          }
        }
      }
    },
    "You are the only member. Calendars, events and lists are deleted from your iCloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist das einzige Mitglied. Kalender, Termine und Listen werden aus deiner iCloud gelöscht."
          }
        }
      }
    },
    "You can change this at any time under Family.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kannst du jederzeit unter „Familie“ ändern."
          }
        }
      }
    },
    "You can invite more people later under Family.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Personen kannst du später unter „Familie“ einladen."
          }
        }
      }
    },
    "You have joined %@. Set up your profile so the others can add you to events.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist %@ beigetreten. Lege dein Profil an, damit die anderen dich zu Terminen hinzufügen können."
          }
        }
      }
    },
    "You lose access to the family's calendars and lists. The others keep them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verlierst den Zugriff auf Kalender und Listen der Familie. Die anderen behalten sie."
          }
        }
      }
    },
    "You lose access to the family's calendars and lists. Your profile stays marked as former member so the others keep their events.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verlierst den Zugriff auf Kalender und Listen der Familie. Dein Profil bleibt als „ehemalig“ erhalten, damit die anderen ihre Termine behalten."
          }
        }
      }
    },
    "You're All Set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bereit"
          }
        }
      }
    },
    "You're Invited": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist eingeladen"
          }
        }
      }
    },
    "Your Family": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Familie"
          }
        }
      }
    },
    "Your calendar, lists, settings and the families you own are deleted everywhere. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kalender, deine Listen, Einstellungen und die Familien, deren Owner du bist, werden überall gelöscht. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "Your family won't see anything you add here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du hier einträgst, sieht deine Familie nicht."
          }
        }
      }
    },
    "Your iCloud, No Account": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine iCloud, kein Konto"
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name"
          }
        }
      }
    },
    "e.g. waste collection, school or club calendars. Updated when you open yafo; each device loads them itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Müllabfuhr, Schul- oder Vereinskalender. Wird beim Öffnen von yafo aktualisiert; jedes Gerät lädt selbst."
          }
        }
      }
    },
