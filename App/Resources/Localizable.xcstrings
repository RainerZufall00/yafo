          }
        }
      }
    },
    "Welcome to yafo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei yafo"
          }
        }
      }
    },
    "What do you need?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was brauchst du?"
          }
        }
      }
    },
    "When you check it off, the to-do moves to the next date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abhaken rückt das Todo auf das nächste Datum."
          }
        }
      }
    },
    "Who's coming?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer ist dabei?"
          }
        }
      }
    },
    "Whole family": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Familie"
          }
        }
      }
    },
    "With due dates, and with a name on them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Fälligkeit und mit einem Namen dran."
          }
        }
      }
