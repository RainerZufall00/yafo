// Gemeinsame Einstellungen der App. Das eigene Developer-Team steht in Local.xcconfig,
// die nicht eingecheckt wird (Vorlage: Local.xcconfig.example).
DEVELOPMENT_TEAM =

// Version für App und Extensions (müssen übereinstimmen). Vor jedem Upload zu TestFlight
// CURRENT_PROJECT_VERSION erhöhen; MARKETING_VERSION nur bei einer neuen Version.
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 3

#include? "Local.xcconfig"
