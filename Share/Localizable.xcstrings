      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuer Termin"
          }
        }
      }
    },
    "No calendar available. Open yafo once, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kalender verfügbar. Öffne yafo einmal und versuch es dann noch mal."
          }
        }
      }
    },
    "No events found in this screenshot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Screenshot wurden keine Termine gefunden."
          }
        }
      }
    },
    "Recognized with Apple Intelligence on this device. The image never leaves it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Apple Intelligence auf diesem Gerät erkannt. Das Bild verlässt es nicht."
          }
        }
      }
    },
    "Starts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginn"
          }
        }
      }
    },
    "The events appear in yafo the next time you open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Termine erscheinen in yafo, sobald du die App das nächste Mal öffnest."
          }
        }
      }
    },
    "The image couldn't be loaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte nicht geladen werden."
          }
        }
      }
    },
    "The image never leaves this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild verlässt dieses Gerät nicht."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel"
          }
        }
      }
    },
    "Without Apple Intelligence, yafo only finds dates in the text. Please check titles and times.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Apple Intelligence findet yafo nur Datumsangaben im Text. Bitte Titel und Zeiten prüfen."
          }
        }
      }
    }
  },
  "version": "1.0"
